%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd06fd07963a3c1498d15948aee7375f, type: 3}
  m_Name: Demon Voicelines Database
  m_EditorClassIdentifier: 
  groups:
  - groupName: Kill
    voiceLines:
    - lineName: You're getting the hang of this
      audioClip: {fileID: 8300000, guid: a38ec8bf884af534bb8190ae71c6d456, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: e86c8d7184101a54ca2bd9a0ffbf949a, type: 2}
      preventInterrupt: 0
    - lineName: "Damn , You\u2019re good!"
      audioClip: {fileID: 8300000, guid: 9e668f26665614e4fa496f15414c6d76, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 53046b9cccdd4884cb9b846e5e27a915, type: 2}
      preventInterrupt: 0
    - lineName: Killl Killll Killll!!!!!!
      audioClip: {fileID: 8300000, guid: 4a08ea02939c41a46a9325c40042b9f5, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 3a5209b484c907c4d9c5dd2b18844341, type: 2}
      preventInterrupt: 0
    - lineName: M..m.m.mm.m.m...Monster Kill!
      audioClip: {fileID: 8300000, guid: 697c9a634f66e8541b799b61035fcc43, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: b71a5956555ac924890bd531b56deebc, type: 2}
      preventInterrupt: 0
    - lineName: Crazzyyyy!
      audioClip: {fileID: 8300000, guid: 4328b41505b582a4caf5c0daab8884a1, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 484692b02aaa1034aaf5efae2096fca3, type: 2}
      preventInterrupt: 0
    - lineName: "Nice Shottt!\u201D"
      audioClip: {fileID: 8300000, guid: ef38f9f3987901341ab56093c28283fc, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: f3c1a210f2650854bb11c0a5ccbf2162, type: 2}
      preventInterrupt: 0
    - lineName: Maybe aim first. Ammo isn't free.
      audioClip: {fileID: 8300000, guid: 2dde37c47efe32b4989f84dc6216340a, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 6884c0f86aad3d342ad457158c5f4e84, type: 2}
      preventInterrupt: 0
    - lineName: If I had a penny for every shot you missed, we'd already have a million
        dollars.
      audioClip: {fileID: 8300000, guid: a0869dce9e674d341b894243045479af, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 97a5f63c50cba094dad9b612ee67c9d9, type: 2}
      preventInterrupt: 0
  - groupName: Finisher
    voiceLines:
    - lineName: "Fuck! , That\u2019s diabolical!"
      audioClip: {fileID: 8300000, guid: 3ab72e31ef124e541a340cd5ffe3e37c, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 652071a0a982df549b1a796da783bddb, type: 2}
      preventInterrupt: 1
    - lineName: Finish Him!
      audioClip: {fileID: 8300000, guid: bfbd08c8ea03c714a9feaad514840fdf, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 7333f6fe79137b9448fbc6eafeaefd50, type: 2}
      preventInterrupt: 1
    - lineName: "Fuck That\u2019s Sick!!!"
      audioClip: {fileID: 8300000, guid: e50032e1f023ca047ac6e388988bbecf, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 73135ea716f144b4cb8d6cfad077256b, type: 2}
      preventInterrupt: 1
    - lineName: OOOH! RIGHT IN THE FACE!
      audioClip: {fileID: 8300000, guid: 80cfb4dab7849d441be20035a8ee6639, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 161d26cb2bdbf6f4faf07e6660d863e4, type: 2}
      preventInterrupt: 1
    - lineName: THAT'S MY BOY!
      audioClip: {fileID: 8300000, guid: 019b8dda768548f44adc0f2f868a68b7, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: caa60c734094ca7499dc0c9a1f8893d8, type: 2}
      preventInterrupt: 1
    - lineName: HAHA! That's disgusting!
      audioClip: {fileID: 8300000, guid: bcf9d17d3dc7f014fa8723669d5400ac, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 85f3ec72b73d1a54a8ad79e41487e0ca, type: 2}
      preventInterrupt: 1
    - lineName: RIP AND TEAR!
      audioClip: {fileID: 8300000, guid: 60fc8118ab3461e4196564c0dbd9767d, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: a115eece41097f747bf5472008a8e270, type: 2}
      preventInterrupt: 1
  - groupName: Game Start
    voiceLines:
    - lineName: It's showtime!
      audioClip: {fileID: 8300000, guid: d2a615361f455314bb6c2e13d94c07fb, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: f5a858161de850840afa8118652bc749, type: 2}
      preventInterrupt: 1
    - lineName: Wake up. We've got things to break.
      audioClip: {fileID: 8300000, guid: 324f3739f5fca964bb79a1afeedc645f, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: d670add7c7092d94e8a19daee4f7160b, type: 3}
      preventInterrupt: 0
    - lineName: Today's a great day to make bad choices again.
      audioClip: {fileID: 8300000, guid: 0ea23b1f1093b6c45b9f64e087a5fee7, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: cd963b7a7ce464b4bbf70acee0cdbb80, type: 2}
      preventInterrupt: 1
    - lineName: Ready? I know I am.
      audioClip: {fileID: 8300000, guid: 75cf84e5a3b1b6c4297e9666c622e770, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 18a46c4053513b648828d045b7eeec52, type: 2}
      preventInterrupt: 1
    - lineName: "You\u2019ll fuck up again , I know"
      audioClip: {fileID: 8300000, guid: 4b215fe3e05fbe145928580d63aa7843, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 21a64bd1dec6db1409b789842001d2b2, type: 2}
      preventInterrupt: 1
    - lineName: Let's see how long you last this time.
      audioClip: {fileID: 8300000, guid: 3a24feba6aea6794c99d7e4fff2f5965, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: c6959b9584453b1438fbecbdf21f4686, type: 2}
      preventInterrupt: 1
    - lineName: Try not to bore me.
      audioClip: {fileID: 8300000, guid: 081192fe53ae9104889bf5343aef3502, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 1eda93744160e0145a9ebe6182e679ad, type: 2}
      preventInterrupt: 1
  - groupName: Low Health
    voiceLines:
    - lineName: Can you see your heartbeat? We're dying!
      audioClip: {fileID: 8300000, guid: a4184f8afbfc11b4ea904764a557880a, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 6b593ff5071f77e4982c056cf110ab02, type: 2}
      preventInterrupt: 1
    - lineName: I said stay alive!
      audioClip: {fileID: 8300000, guid: fd84a0c4ccd02194ca68b6bc246b9e72, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: fac4e1e264c254e4d83c36bb8200f3d5, type: 2}
      preventInterrupt: 1
    - lineName: Are you trying to get both of us killed?
      audioClip: {fileID: 8300000, guid: 01c47ef1c03c2ce4c8518d30e3c8fb60, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 112a43afbd76dd749a66b13b93d4e5bd, type: 2}
      preventInterrupt: 1
  - groupName: Taking Damage
    voiceLines:
    - lineName: That hurt!
      audioClip: {fileID: 8300000, guid: c504fa038e64cb34bab370bb8ddc1396, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: fe99dcc1acf00d240802bec247325eb8, type: 2}
      preventInterrupt: 1
    - lineName: Taking fire!
      audioClip: {fileID: 8300000, guid: 934936ae230718743b18b5e1629ce047, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 4f0f53124d9ba6c4c9df300cfb32886e, type: 2}
      preventInterrupt: 1
    - lineName: I'm hit!
      audioClip: {fileID: 8300000, guid: 35b5065fbd09caf4e80cfd735ce71c21, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 1d0f9f78a32d3364d8a265b340922d75, type: 2}
      preventInterrupt: 1
    - lineName: Getting shot at!
      audioClip: {fileID: 8300000, guid: e7b48a27e7c6f5746a2084634bb61b28, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 7e12be5ad4c66864182aeb1effc7cbac, type: 2}
      preventInterrupt: 1
    - lineName: ouch!!!!
      audioClip: {fileID: 8300000, guid: 0803b0b3659e6a54b8e9f5e83381544c, type: 3}
      volume: 1
      animationClip: {fileID: 7400000, guid: 875806f7c10079f44a6bf4a46826a753, type: 2}
      preventInterrupt: 1
  - groupName: Player Dies
    voiceLines:
    - lineName: Come on... I wasn't done with you.
      audioClip: {fileID: 8300000, guid: a92e71696f9f8854aa597b41460e98dd, type: 3}
      volume: 1
      animationClip: {fileID: 0}
      preventInterrupt: 1
    - lineName: Get up. We're trying that again.
      audioClip: {fileID: 8300000, guid: d87e689c9ef9f084cba61e9b33a76914, type: 3}
      volume: 1
      animationClip: {fileID: 0}
      preventInterrupt: 0
    - lineName: Don't make me carry this whole thing.
      audioClip: {fileID: 8300000, guid: 2805bab0a254f564b860d063ace9f9a4, type: 3}
      volume: 1
      animationClip: {fileID: 0}
      preventInterrupt: 1
    - lineName: I was just starting to have fun.
      audioClip: {fileID: 8300000, guid: 5c0365fd84175224fb64a6669592a70b, type: 3}
      volume: 1
      animationClip: {fileID: 0}
      preventInterrupt: 0
    - lineName: Let's pretend nobody saw that.
      audioClip: {fileID: 8300000, guid: a86ed6ef8adf4554abda8a9d2c33e367, type: 3}
      volume: 1
      animationClip: {fileID: 0}
      preventInterrupt: 1
    - lineName: You got us both killed.
      audioClip: {fileID: 8300000, guid: 18dab704422f89f48aebfde6007d985e, type: 3}
      volume: 1
      animationClip: {fileID: 0}
      preventInterrupt: 1
    - lineName: I think I have to lower the difficulty for you!
      audioClip: {fileID: 8300000, guid: 5dcc1c501622b9941a456701f63731a2, type: 3}
      volume: 1
      animationClip: {fileID: 0}
      preventInterrupt: 0
    - lineName: Nice one. We're dead.
      audioClip: {fileID: 8300000, guid: d62f772ae515b7c4899856869b78032d, type: 3}
      volume: 1
      animationClip: {fileID: 0}
      preventInterrupt: 0
    - lineName: Brilliant. Just brilliant.
      audioClip: {fileID: 8300000, guid: a414dbb0abb4bf44380386601bdcad22, type: 3}
      volume: 1
      animationClip: {fileID: 0}
      preventInterrupt: 1
