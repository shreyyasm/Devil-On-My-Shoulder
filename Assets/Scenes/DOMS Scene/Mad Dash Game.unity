  m_Name: 
  m_EditorClassIdentifier: 
  tutorialPanel: {fileID: 1082288736}
  instructionText: {fileID: 1099709699}
  iconImage: {fileID: 678343359}
  promptEnterDuration: 0.35
  promptPopStrength: 0.12
  promptPopDuration: 0.18
  steps:
  - instructionText: Use "WASD" to MOVE!
    iconSprite: {fileID: 21300000, guid: 3c18d177cd15e704bb9bf6c968e99dd6, type: 3}
    contextOnly: 0
    keys: 77000000610000007300000064000000
    mouseButton: 0
    movementRequirement: 0
    waitForExternalTrigger: 0
    waitToShowForExternalTrigger: 0
    delayAfterComplete: 0.4
    autoAdvanceTimeout: 0
    pauseTimeUntilInput: 0
    objectsToEnable: []
    isComplete: 0
    timeShown: 0
  - instructionText: Press "MOUSE 0" to FIRE!
    iconSprite: {fileID: 21300000, guid: 5540e5987ad5dda4a8c5cc346ce532f3, type: 3}
    contextOnly: 0
    keys: 43010000
    mouseButton: 0
    movementRequirement: 0
    waitForExternalTrigger: 0
    waitToShowForExternalTrigger: 0
    delayAfterComplete: 0.4
    autoAdvanceTimeout: 0
    pauseTimeUntilInput: 1
    objectsToEnable: []
    isComplete: 0
    timeShown: 0
  - instructionText: Kill ENEMIES to keep your heart beating to stay ALIVE!
    iconSprite: {fileID: 21300000, guid: 3fda65f95d9ec2c40878683c694939a6, type: 3}
    contextOnly: 0
    keys: 
    mouseButton: 0
    movementRequirement: 0
    waitForExternalTrigger: 0
    waitToShowForExternalTrigger: 0
    delayAfterComplete: 0.4
    autoAdvanceTimeout: 0
    pauseTimeUntilInput: 1
    objectsToEnable: []
    isComplete: 0
    timeShown: 0
  - instructionText: Also use "SHIFT" to KICK Enemies, Doors and Parry Projectiles!
    iconSprite: {fileID: 21300000, guid: 25c1c76e5770a6b4ebb4eac77e44b5db, type: 3}
    contextOnly: 0
    keys: 30010000
    mouseButton: 0
    movementRequirement: 0
    waitForExternalTrigger: 0
    waitToShowForExternalTrigger: 0
    delayAfterComplete: 0.4
    autoAdvanceTimeout: 0
    pauseTimeUntilInput: 1
    objectsToEnable: []
    isComplete: 0
    timeShown: 0
  - instructionText: Press "SHIFT" while Moving to SLIDE or DASH
    iconSprite: {fileID: 21300000, guid: 152f8db9890a85b438d43b34924ee511, type: 3}
    contextOnly: 0
    keys: 30010000
    mouseButton: 0
    movementRequirement: 1
    waitForExternalTrigger: 0
    waitToShowForExternalTrigger: 0
    delayAfterComplete: 0.4
    autoAdvanceTimeout: 0
    pauseTimeUntilInput: 1
    objectsToEnable: []
    isComplete: 0
    timeShown: 0
  - instructionText: Use "MOUSE 1" to Kill Enemies with a Finisher on reaching EX
      Meter!
    iconSprite: {fileID: 21300000, guid: 0d000254db109364295fe3f0758cd493, type: 3}
    contextOnly: 0
    keys: 44010000
    mouseButton: 0
    movementRequirement: 0
    waitForExternalTrigger: 0
    waitToShowForExternalTrigger: 0
    delayAfterComplete: 0.4
    autoAdvanceTimeout: 0
    pauseTimeUntilInput: 1
    objectsToEnable: []
    isComplete: 0
    timeShown: 0
  - instructionText: Use "MOUSE 1" to perform DEMON ABILITY on reaching Super Meter!
    iconSprite: {fileID: 21300000, guid: 74ea6242b73817c4aa873bc70ecbc23e, type: 3}
    contextOnly: 0
    keys: 44010000
    mouseButton: 0
    movementRequirement: 0
    waitForExternalTrigger: 0
    waitToShowForExternalTrigger: 0
    delayAfterComplete: 0.4
    autoAdvanceTimeout: 0
    pauseTimeUntilInput: 1
    objectsToEnable: []
    isComplete: 0
    timeShown: 0
  - instructionText: Press "Shift" to Parry Big Projectiles by kicking it!
    iconSprite: {fileID: 21300000, guid: 2c8e989a6a61c0545828deea66cff640, type: 3}
    contextOnly: 1
    keys: 30010000
    mouseButton: 0
    movementRequirement: 0
    waitForExternalTrigger: 0
    waitToShowForExternalTrigger: 0
    delayAfterComplete: 0.4
    autoAdvanceTimeout: 0
    pauseTimeUntilInput: 0
    objectsToEnable: []
    isComplete: 0
    timeShown: 0
  - instructionText: Press "Space + Shift" to do Jump Dash!
    iconSprite: {fileID: 21300000, guid: b1858b74bd1a1cf4d9b3c7cd30e5e425, type: 3}
    contextOnly: 1
    keys: 30010000
    mouseButton: 0
    movementRequirement: 0
    waitForExternalTrigger: 0
    waitToShowForExternalTrigger: 0
    delayAfterComplete: 0.4
    autoAdvanceTimeout: 0
    pauseTimeUntilInput: 0
    objectsToEnable: []
    isComplete: 0
    timeShown: 0
  - instructionText: "Press \"Shift\" to Slide to Enter Tunnels! \r\n"
    iconSprite: {fileID: 21300000, guid: 152f8db9890a85b438d43b34924ee511, type: 3}
    contextOnly: 1
    keys: 30010000
    mouseButton: 0
    movementRequirement: 0
